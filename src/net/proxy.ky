import net.aio;
import net.eventedio;
import net.poller;
import os.sys;
import os.socket;
import io.file;
import string;
import list;
import bytes;

const MAX_INFLIGHT_PER_REACTOR = 4096;

pub enum LbStrategy {
    RoundRobin,
    Weighted,
    LeastConn,
    ConsistentHash,
}

pub fn strategyFromName(s: string): LbStrategy {
    if (string.eql(s, "weighted")) {
        return LbStrategy.Weighted;
    }
    if (string.eql(s, "leastconn")) {
        return LbStrategy.LeastConn;
    }
    if (string.eql(s, "consistenthash")) {
        return LbStrategy.ConsistentHash;
    }
    return LbStrategy.RoundRobin;
}

fn hashKey(s: string): int {
    return string.hash(s) & 2147483647;
}

fn reqKey(raw: string): string {
    let sp1 = string.indexOf(raw, " ");
    if (sp1 < 0) {
        return "/";
    }
    let rest = string.slice(raw, sp1 + 1, string.len(raw));
    let sp2 = string.indexOf(rest, " ");
    if (sp2 < 0) {
        return "/";
    }
    return string.slice(rest, 0, sp2);
}

// Backend is a CLASS (reference type), not a value struct: the pool holds the authoritative backends and
// `select` hands back a handle to one of them, so `acquireConn`/`releaseConn` on the returned backend must
// mutate the pool's own instance (that is how least-connection tracking works). As a value struct, select
// would return a copy and every connection-count update would be lost - least-conn could never swing off
// the first backend. (Surfaced when struct became strictly value-semantic; backends are shared state.)
pub class Backend {
    pub host: string,
    pub port: int,
    pub idle: List<List<long>>,
    pub weight: int,
    pub active: List<int>,
    pub reuse: bool,
    pub up: int,
    pub okStreak: int,
    pub failStreak: int,

    init(host: string, port: int) {
        self.host = host;
        self.port = port;
        self.weight = 1;
        self.up = 1;
        self.okStreak = 0;
        self.failStreak = 0;
        self.reuse = true;
        self.idle = List<List<long>>();
        self.active = List<int>();
        let nt = kyte_worker_count() as int;
        let i = 0;
        while (i < nt) {
            self.idle.push(List<long>());
            self.active.push(0);
            i = i + 1;
        }
    }

    pub fn acquireConn(self: Backend): void {
        let t = kyte_thread_id() as int;
        self.active.set(t, (self.active.get(t) ?? 0) + 1);
    }

    pub fn releaseConn(self: Backend): void {
        let t = kyte_thread_id() as int;
        let v = (self.active.get(t) ?? 0) - 1;
        self.active.set(t, if (v < 0) 0 else v);
    }

    pub fn activeConns(self: Backend): int {
        let t = kyte_thread_id() as int;
        return self.active.get(t) ?? 0;
    }

    pub fn isUp(self: Backend): bool {
        return self.up != 0;
    }

    pub fn observe(self: Backend, ok: bool, rise: int, fall: int): void {
        if (ok) {
            self.okStreak = self.okStreak + 1;
            self.failStreak = 0;
            if (self.up == 0 && self.okStreak >= rise) {
                self.up = 1;
            }
        } else {
            self.failStreak = self.failStreak + 1;
            self.okStreak = 0;
            if (self.up != 0 && self.failStreak >= fall) {
                self.up = 0;
            }
        }
    }
}

pub struct HttpMsg {
    pub bytes: string,
    pub framed: bool,
    pub wantClose: bool,

    init(bytes: string, framed: bool, wantClose: bool) {
        self.bytes = bytes;
        self.framed = framed;
        self.wantClose = wantClose;
    }
}

pub struct Pool {
    pub backends: List<Backend>,
    pub cursors: List<int>,
    pub strategy: LbStrategy,
    pub wexpanded: List<int>,
    pub ringHash: List<int>,
    pub ringIdx: List<int>,
    pub inflight: List<int>,
    pub hcEnabled: bool,
    pub hcIntervalMs: int,
    pub hcTimeoutMs: int,
    pub hcRise: int,
    pub hcFall: int,
    pub hcPath: string,

    init() {
        self.backends = List<Backend>();
        self.cursors = List<int>();
        self.strategy = LbStrategy.RoundRobin;
        self.wexpanded = List<int>();
        self.ringHash = List<int>();
        self.ringIdx = List<int>();
        self.hcEnabled = false;
        self.hcIntervalMs = 2000;
        self.hcTimeoutMs = 1000;
        self.hcRise = 2;
        self.hcFall = 3;
        self.hcPath = "";
        self.inflight = List<int>();
        let nt = kyte_worker_count() as int;
        let i = 0;
        while (i < nt) {
            self.cursors.push(0);
            self.inflight.push(0);
            i = i + 1;
        }
    }

    pub fn setStrategy(self: Pool, s: LbStrategy): void {
        self.strategy = s;
    }

    pub fn enableHealthChecks(self: Pool, intervalMs: int, timeoutMs: int, rise: int, fall: int): void {
        self.hcEnabled = true;
        self.hcIntervalMs = if (intervalMs > 0) intervalMs else 2000;
        self.hcTimeoutMs = if (timeoutMs > 0) timeoutMs else 1000;
        self.hcRise = if (rise > 0) rise else 1;
        self.hcFall = if (fall > 0) fall else 1;
    }

    pub fn setHealthPath(self: Pool, path: string): void {
        self.hcPath = path;
    }

    fn healthyFrom(self: Pool, start: int): int {
        let n = self.backends.size();
        if (n == 0) {
            return -1;
        }
        let k = 0;
        while (k < n) {
            let idx = (start + k) % n;
            if ((self.backends.get(idx) ?? Backend("", 0)).isUp()) {
                return idx;
            }
            k = k + 1;
        }
        return -1;
    }

    pub fn add(self: Pool, host: string, port: int): void {
        self.addWeighted(host, port, 1);
    }

    pub fn addWeighted(self: Pool, host: string, port: int, weight: int): void {
        let b = Backend(host, port);
        b.weight = if (weight > 0) weight else 1;
        if (self.hcEnabled) {
            b.up = 0;
            b.okStreak = 0;
        }
        let idx = self.backends.size();
        self.backends.push(b);
        let w = 0;
        while (w < b.weight) {
            self.wexpanded.push(idx);
            w = w + 1;
        }
        let v = 0;
        while (v < 40) {
            self.ringHash.push(hashKey(host + ":" + port + "#" + v));
            self.ringIdx.push(idx);
            v = v + 1;
        }
    }

    pub fn size(self: Pool): int {
        return self.backends.size();
    }

    // Index of the backend serving host:port, or -1. Used by live discovery reconcile to preserve the
    // existing Backend object (its health state + in-flight conn counts) across a pool rebuild.
    fn indexOf(self: Pool, host: string, port: int): int {
        let i = 0;
        while (i < self.backends.size()) {
            let b = self.backends.get(i) ?? Backend("", 0);
            if (string.eql(b.host, host) && b.port == port) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // The backend serving host:port, or a throwaway empty Backend("", 0) if none. Lets a caller (and the
    // reconcile tests) address a specific replica without disturbing the round-robin cursor.
    pub fn backendFor(self: Pool, host: string, port: int): Backend {
        let i = self.indexOf(host, port);
        if (i < 0) { return Backend("", 0); }
        return self.backends.get(i) ?? Backend("", 0);
    }

    // Reconcile the pool to serve EXACTLY the endpoints in `eps` ("host:port"), the set kynatord
    // publishes to the discovery file each reconcile tick. This is the data-plane's live-membership
    // update: a scaled-up replica is added, a departed one is dropped, with zero manual reconfig. It is a
    // full rebuild of the backend list + the index-keyed auxiliary structures (weight expansion, hash
    // ring, cursors), but it PRESERVES the existing Backend instance for any endpoint that persists, so a
    // healthy replica keeps its up/streak state and active-connection counts instead of flapping back to
    // "down" (and re-passing health checks) on every refresh. A brand-new endpoint starts down when health
    // checks are on (it must pass `rise` probes first), exactly as addWeighted does. Runs synchronously
    // between the reactor's cooperative yields, so no select() observes a half-rebuilt pool. Returns the
    // number of membership changes (added + removed); 0 means the live set was unchanged.
    pub fn setEndpoints(self: Pool, eps: List<string>): int {
        let next = List<Backend>();
        let seen = List<string>();
        let added = 0;
        let i = 0;
        while (i < eps.size()) {
            let ep = eps.get(i) ?? "";
            i = i + 1;
            if (string.eql(ep, "")) { continue; }
            // De-duplicate: the discovery file could list the same endpoint twice.
            let dup = false;
            let s = 0;
            while (s < seen.size()) {
                if (string.eql(seen.get(s) ?? "", ep)) { dup = true; }
                s = s + 1;
            }
            if (dup) { continue; }
            let hp = string.split(ep, ":");
            if (hp.size() < 2) { continue; }
            let host = hp.get(0) ?? "";
            let port = string.parseI64(hp.get(1) ?? "0") as int;
            if (string.eql(host, "") || port <= 0) { continue; }
            seen.push(ep);
            let idx = self.indexOf(host, port);
            if (idx >= 0) {
                next.push(self.backends.get(idx) ?? Backend(host, port));   // preserve health + conn state
            } else {
                let b = Backend(host, port);
                if (self.hcEnabled) { b.up = 0; b.okStreak = 0; }
                next.push(b);
                added = added + 1;
            }
        }
        let removed = 0;
        let k = 0;
        while (k < self.backends.size()) {
            let b = self.backends.get(k) ?? Backend("", 0);
            if (self.indexOfIn(seen, b.host, b.port) < 0) { removed = removed + 1; }
            k = k + 1;
        }
        // Rebuild backends + all index-keyed auxiliary structures from the reconciled set.
        self.backends = next;
        self.wexpanded = List<int>();
        self.ringHash = List<int>();
        self.ringIdx = List<int>();
        let j = 0;
        while (j < self.backends.size()) {
            let b = self.backends.get(j) ?? Backend("", 0);
            let w = 0;
            while (w < b.weight) { self.wexpanded.push(j); w = w + 1; }
            let v = 0;
            while (v < 40) {
                self.ringHash.push(hashKey(b.host + ":" + b.port + "#" + v));
                self.ringIdx.push(j);
                v = v + 1;
            }
            j = j + 1;
        }
        // Cursors index modulo n at selection time, so a stale value stays valid across a resize; leave them
        // alone. Resetting on every refresh tick (this runs each discoveryRefreshMs) would snap round-robin
        // back to index 0 constantly and starve the tail of the pool.
        return added + removed;
    }

    // Is "host:port" present in the de-duplicated desired-endpoint list `seen`? (removal accounting)
    fn indexOfIn(self: Pool, seen: List<string>, host: string, port: int): int {
        let target = host + ":" + port;
        let i = 0;
        while (i < seen.size()) {
            if (string.eql(seen.get(i) ?? "", target)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    pub fn select(self: Pool, key: string): Backend {
        let n = self.backends.size();
        if (n == 0) {
            return Backend("", 0);
        }
        let t = kyte_thread_id() as int;
        switch (self.strategy) {
            case LbStrategy.RoundRobin: {
                let c = self.cursors.get(t) ?? 0;
                self.cursors.set(t, c + 1);
                let idx = self.healthyFrom(c % n);
                if (idx < 0) {
                    return Backend("", 0);
                }
                return self.backends.get(idx) ?? Backend("", 0);
            }
            case LbStrategy.Weighted: {
                let m = self.wexpanded.size();
                let c = self.cursors.get(t) ?? 0;
                self.cursors.set(t, c + 1);
                let raw = if (m == 0) c % n else self.wexpanded.get(c % m) ?? 0;
                let idx = self.healthyFrom(raw);
                if (idx < 0) {
                    return Backend("", 0);
                }
                return self.backends.get(idx) ?? Backend("", 0);
            }
            case LbStrategy.LeastConn: {
                let best = -1;
                let bestA = 0;
                let i = 0;
                while (i < n) {
                    let bk = self.backends.get(i) ?? Backend("", 0);
                    if (bk.isUp()) {
                        let a = bk.activeConns();
                        if (best < 0 || a < bestA) {
                            bestA = a;
                            best = i;
                        }
                    }
                    i = i + 1;
                }
                if (best < 0) {
                    return Backend("", 0);
                }
                return self.backends.get(best) ?? Backend("", 0);
            }
            case LbStrategy.ConsistentHash: {
                let h = hashKey(key);
                let ring = self.ringHash.size();
                let bestGE = -1;
                let bestGEH = 0;
                let gmin = -1;
                let gminH = 0;
                let i = 0;
                while (i < ring) {
                    let rh = self.ringHash.get(i) ?? 0;
                    if (gmin == -1 || rh < gminH) {
                        gmin = i;
                        gminH = rh;
                    }
                    if (rh >= h && (bestGE == -1 || rh < bestGEH)) {
                        bestGE = i;
                        bestGEH = rh;
                    }
                    i = i + 1;
                }
                let pick = if (bestGE != -1) bestGE else gmin;
                let raw = if (pick != -1) self.ringIdx.get(pick) ?? 0 else 0;
                let idx = self.healthyFrom(raw);
                if (idx < 0) {
                    return Backend("", 0);
                }
                return self.backends.get(idx) ?? Backend("", 0);
            }
        }
        return self.backends.get(0) ?? Backend("", 0);
    }

    pub fn next(self: Pool): Backend {
        return self.select("");
    }

    pub fn totalActive(self: Pool): int {
        let sum = 0;
        let nb = self.backends.size();
        let i = 0;
        while (i < nb) {
            let b = self.backends.get(i) ?? Backend("", 0);
            let nr = b.active.size();
            let j = 0;
            while (j < nr) {
                sum = sum + b.active.get(j) ?? 0;
                j = j + 1;
            }
            i = i + 1;
        }
        return sum;
    }
}

fn findHeaderEnd(buf: long, len: int): int {
    let i = 0;
    while (i + 4 <= len) {
        if (bytes.read_byte(buf, i) == 13 && bytes.read_byte(buf, i + 1) == 10 && bytes.read_byte(buf, i + 2) == 13 && bytes.read_byte(buf, i + 3) == 10) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn findCI(buf: long, limit: int, needle: string): int {
    let nlen = needle.length;
    if (nlen == 0) {
        return -1;
    }
    let i = 0;
    while (i + nlen <= limit) {
        let j = 0;
        let matched = true;
        while (j < nlen) {
            let c = bytes.read_byte(buf, i + j);
            if (c >= 65 && c <= 90) {
                c = c + 32;
            }
            if (c != needle[j]) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if (matched) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn contentLength(buf: long, hdrEnd: int): int {
    let idx = findCI(buf, hdrEnd, "content-length:");
    if (idx == -1) {
        return -1;
    }
    let p = idx + 15;
    while (p < hdrEnd && bytes.read_byte(buf, p) == 32) {
        p = p + 1;
    }
    let val = 0;
    let any = false;
    while (p < hdrEnd) {
        let c = bytes.read_byte(buf, p);
        if (c < 48 || c > 57) {
            break;
        }
        val = val * 10 + (c - 48);
        any = true;
        p = p + 1;
    }
    if (!any) {
        return -1;
    }
    return val;
}

fn isChunked(buf: long, hdrEnd: int): bool {
    if (findCI(buf, hdrEnd, "transfer-encoding:") == -1) {
        return false;
    }
    return findCI(buf, hdrEnd, "chunked") != -1;
}

fn findCRLF(buf: long, from: int, len: int): int {
    let p = from;
    while (p + 1 < len) {
        if (bytes.read_byte(buf, p) == 13 && bytes.read_byte(buf, p + 1) == 10) {
            return p;
        }
        p = p + 1;
    }
    return -1;
}

fn parseHex(buf: long, from: int, to: int): int {
    let p = from;
    let v = 0;
    while (p < to) {
        let c = bytes.read_byte(buf, p);
        let d = -1;
        if (c >= 48 && c <= 57) {
            d = c - 48;
        } else if (c >= 97 && c <= 102) {
            d = c - 87;
        } else if (c >= 65 && c <= 70) {
            d = c - 55;
        } else {
            break;
        }
        v = v * 16 + d;
        p = p + 1;
    }
    return v;
}

fn chunkedEnd(buf: long, start: int, len: int): int {
    let p = start;
    while (p < len) {
        let lineEnd = findCRLF(buf, p, len);
        if (lineEnd == -1) {
            return -1;
        }
        let size = parseHex(buf, p, lineEnd);
        let dataStart = lineEnd + 2;
        if (size == 0) {
            if (dataStart + 2 <= len) {
                return dataStart + 2;
            }
            return -1;
        }
        p = dataStart + size + 2;
    }
    return -1;
}

async fn readMessage(s: AsyncStream, isResponse: bool, tmo: int): HttpMsg {
    let cap = 65536;
    let buf: long = bytes.alloc(cap);
    let len = 0;
    let _ = s.setTimeout(tmo);
    let hdrEnd = findHeaderEnd(buf, len);
    while (hdrEnd == -1) {
        if (len >= cap) {
            bytes.free(buf);
            return HttpMsg("", false, true);
        }
        let n = await s.recvInto(buf + len, cap - len);
        if (n <= 0) {
            bytes.free(buf);
            return HttpMsg("", false, true);
        }
        len = len + n;
        hdrEnd = findHeaderEnd(buf, len);
    }
    let wantClose = findCI(buf, hdrEnd, "connection: close") != -1;
    let bodyStart = hdrEnd + 4;
    let msgEnd = bodyStart;
    let framed = true;
    if (isChunked(buf, hdrEnd)) {
        let cend = chunkedEnd(buf, bodyStart, len);
        while (cend == -1) {
            if (len >= cap) {
                framed = false;
                break;
            }
            let n = await s.recvInto(buf + len, cap - len);
            if (n <= 0) {
                framed = false;
                break;
            }
            len = len + n;
            cend = chunkedEnd(buf, bodyStart, len);
        }
        msgEnd = if (cend == -1) len else cend;
    } else {
        let need = contentLength(buf, hdrEnd);
        if (need >= 0) {
            while (len - bodyStart < need) {
                if (len >= cap) {
                    framed = false;
                    break;
                }
                let n = await s.recvInto(buf + len, cap - len);
                if (n <= 0) {
                    framed = false;
                    break;
                }
                len = len + n;
            }
            msgEnd = bodyStart + need;
            if (msgEnd > len) {
                msgEnd = len;
            }
        } else if (isResponse) {
            framed = false;
            while (len < cap) {
                let n = await s.recvInto(buf + len, cap - len);
                if (n <= 0) {
                    break;
                }
                len = len + n;
            }
            msgEnd = len;
        } else {
            msgEnd = bodyStart;
        }
    }
    let msg = bytes.read_string(buf, msgEnd);
    bytes.free(buf);
    return HttpMsg(msg, framed, wantClose);
}

fn errorResponse(code: int, reason: string, body: string): string {
    return `HTTP/1.1 ${code} ${reason}\r\nContent-Length: ${body.length}\r\nConnection: close\r\n\r\n${body}`;
}

async fn acquireBackend(b: Backend): (long, bool) {
    let t = kyte_thread_id() as int;
    let lst = b.idle.get(t) ?? List<long>();
    let n = lst.size();
    if (n > 0) {
        let fd = lst.get(n - 1) ?? 0;
        lst.remove(n - 1);
        if (fd != 0) {
            return (fd, true);
        }
    }
    let s = await aio.asyncConnect(b.host, b.port);
    return (s.sock, false);
}

fn releaseBackend(b: Backend, fd: long, reusable: bool, kq: int): void {
    if (fd == 0) {
        return;
    }
    if (!reusable || !b.reuse) {
        let s = aio.AsyncStream(fd);
        s.kq = kq;
        s.close();
        return;
    }
    let t = kyte_thread_id() as int;
    let lst = b.idle.get(t) ?? List<long>();
    if (lst.size() < 256) {
        lst.push(fd);
    } else {
        let s = aio.AsyncStream(fd);
        s.kq = kq;
        s.close();
    }
}

async fn exchange(fd: long, kq: int, reqBytes: string, tmo: int): HttpMsg {
    let s = aio.AsyncStream(fd);
    s.kq = kq;
    let _ = s.setTimeout(tmo);
    let _ = await s.sendStr(reqBytes);
    return await readMessage(s, true, tmo);
}

pub async fn forwardOnce(pool: Pool, reqBytes: string, tmo: int): string {
    let b = pool.select("");
    if (b.port == 0) {
        return "";
    }
    return await forward(b, reqBytes, false, tmo);
}

pub async fn probeOnce(b: Backend, timeoutMs: int, path: string): bool {
    return await probeBackend(b, timeoutMs, path);
}

async fn forward(b: Backend, reqBytes: string, reqWantClose: bool, tmo: int): string {
    let kq = poller.currentKq();
    let (fd, reused) = await acquireBackend(b);
    if (fd == 0) {
        return "";
    }
    let resp = await exchange(fd, kq, reqBytes, tmo);
    if (string.eql(resp.bytes, "") && reused) {
        let s = aio.AsyncStream(fd);
        s.kq = kq;
        s.close();
        let fresh = await aio.asyncConnect(b.host, b.port);
        if (fresh.sock == 0) {
            return "";
        }
        let resp2 = await exchange(fresh.sock, kq, reqBytes, tmo);
        if (string.eql(resp2.bytes, "")) {
            releaseBackend(b, fresh.sock, false, kq);
            return "";
        }
        let reusable2 = resp2.framed && !resp2.wantClose && !reqWantClose;
        releaseBackend(b, fresh.sock, reusable2, kq);
        return resp2.bytes;
    }
    if (string.eql(resp.bytes, "")) {
        releaseBackend(b, fd, false, kq);
        return "";
    }
    let reusable = resp.framed && !resp.wantClose && !reqWantClose;
    releaseBackend(b, fd, reusable, kq);
    return resp.bytes;
}

async fn handleClient(pool: Pool, fd: int, kq: int, tmo: int): int {
    let client = aio.AsyncStream(fd as long);
    client.kq = kq;
    let _ = client.setTimeout(tmo);
    let alive = true;
    while (alive) {
        let req = await readMessage(client, false, tmo);
        if (string.eql(req.bytes, "")) {
            alive = false;
            break;
        }
        let attempts = 0;
        let resp = "";
        let served = false;
        while (attempts < 3) {
            let b = pool.select(reqKey(req.bytes));
            if (b.port == 0) {
                break;
            }
            b.acquireConn();
            resp = await forward(b, req.bytes, req.wantClose, tmo);
            b.releaseConn();
            if (!string.eql(resp, "")) {
                served = true;
                break;
            }
            b.observe(false, pool.hcRise, pool.hcFall);
            attempts = attempts + 1;
        }
        if (!served) {
            let _ = await client.sendStr(errorResponse(502, "Bad Gateway", "no healthy upstream"));
            alive = false;
            break;
        }
        let _ = await client.sendStr(resp);
        if (req.wantClose) {
            alive = false;
        }
    }
    client.close();
    return 0;
}

fn healthyStatus(raw: string): bool {
    let sp = string.indexOf(raw, " ");
    if (sp < 0) {
        return false;
    }
    let rest = string.slice(raw, sp + 1, string.len(raw));
    let sp2 = string.indexOf(rest, " ");
    let codeStr = if (sp2 < 0) rest else string.slice(rest, 0, sp2);
    let code = string.parseI64(codeStr) as int;
    return code >= 200 && code < 400;
}

async fn probeBackend(b: Backend, timeoutMs: int, path: string): bool {
    let kq = poller.currentKq();
    let (fd, reused) = await acquireBackend(b);
    if (fd == 0) {
        return false;
    }
    if (string.len(path) == 0) {
        releaseBackend(b, fd, true, kq);
        return true;
    }
    let req = `GET ${path} HTTP/1.1\r\nHost: ${b.host}\r\nConnection: keep-alive\r\n\r\n`;
    let resp = await exchange(fd, kq, req, timeoutMs);
    if (string.eql(resp.bytes, "") && reused) {
        let st = aio.AsyncStream(fd);
        st.kq = kq;
        st.close();
        let fr = await aio.asyncConnect(b.host, b.port);
        if (fr.sock == 0) {
            return false;
        }
        let resp2 = await exchange(fr.sock, kq, req, timeoutMs);
        let ok2 = !string.eql(resp2.bytes, "") && healthyStatus(resp2.bytes);
        releaseBackend(b, fr.sock, resp2.framed && !resp2.wantClose, kq);
        return ok2;
    }
    let ok = !string.eql(resp.bytes, "") && healthyStatus(resp.bytes);
    releaseBackend(b, fd, resp.framed && !resp.wantClose, kq);
    return ok;
}

async fn healthCheckLoop(pool: Pool): int {
    while (true) {
        let n = pool.backends.size();
        let i = 0;
        while (i < n) {
            let b = pool.backends.get(i) ?? Backend("", 0);
            let ok = await probeBackend(b, pool.hcTimeoutMs, pool.hcPath);
            b.observe(ok, pool.hcRise, pool.hcFall);
            i = i + 1;
        }
        let _ = await aio.sleep(pool.hcIntervalMs);
    }
    return 0;
}

pub fn bindAddrFor(host: string): long {
    if (string.eql(host, "")) {
        return 0 as long;
    }
    let a = socket.resolveHost4(host);
    if (a < 0) {
        console.log("proxy: VIP host '" + host + "' is not a valid IPv4 address and did not resolve; binding all interfaces (INADDR_ANY)");
        return 0 as long;
    }
    return a;
}

async fn proxyAcceptLoop(pool: Pool, host: string, port: int, tmo: int): int {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, bindAddrFor(host));
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        console.log("proxy: failed to bind front port (in use?)");
        return -1;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);
    let kq = poller.currentKq();
    while (true) {
        let rs = await eventedio.reactorAccept(lfd, kq);
        if (rs.isOpen()) {
            sys.setNonBlocking(rs.fdOf());
            let tid = kyte_thread_id() as int;
            let cur = pool.inflight.get(tid) ?? 0;
            if (cur >= MAX_INFLIGHT_PER_REACTOR) {
                let s = aio.AsyncStream(rs.fdOf());
                s.kq = kq;
                s.close();
            } else {
                pool.inflight.set(tid, cur + 1);
                coroStart(handleClientCounted(pool, rs.fdOf(), kq, tmo, tid));
            }
        }
    }
    return 0;
}

async fn handleClientCounted(pool: Pool, fd: int, kq: int, tmo: int, tid: int): int {
    let r = await handleClient(pool, fd, kq, tmo);
    pool.inflight.set(tid, (pool.inflight.get(tid) ?? 0) - 1);
    return r;
}

async fn runProxy(pool: Pool, host: string, port: int, tmo: int): int {
    if (pool.hcEnabled) {
        aio.pinNextCoro(0);
        spawn healthCheckLoop(pool);
    }
    let n = aio.reactorCount();
    let i = 1;
    while (i < n) {
        aio.pinNextCoro(i);
        spawn proxyAcceptLoop(pool, host, port, tmo);
        i = i + 1;
    }
    console.log("Kyte reverse proxy listening (share-nothing)");
    return await proxyAcceptLoop(pool, host, port, tmo);
}

pub fn serveOnReactor(pool: Pool, port: int, tmo: int): void {
    let r = poller.Reactor(1024, 16384, 1024);
    poller.setCurrent(r.kq);
    if (pool.hcEnabled) {
        coroStart(healthCheckLoop(pool));
    }
    coroStart(proxyAcceptLoop(pool, "", port, tmo));
    console.log("Kyte reverse proxy listening (single reactor)");
    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            kyte_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

// Read the live endpoints kynatord advertises for `svc` from its discovery file. One line per endpoint,
// "svc=host:port". Kept here (a small duplicate of net.service.resolveAllFrom) so the data plane's live
// reconcile has no dependency on net.service, which itself imports this module (that would be an import
// cycle). Missing file -> empty (the pool simply keeps its current members until the file appears).
fn readDiscoveryEndpoints(discoveryFile: string, svc: string): List<string> {
    let out = List<string>();
    if (!File.exists(discoveryFile)) { return out; }
    let text = File.readText(discoveryFile);
    let needle = svc + "=";
    let lines = string.split(text, "\n");
    let i = 0;
    while (i < lines.size()) {
        let ln = lines.get(i) ?? "";
        if (string.startsWith(ln, needle)) {
            out.push(string.slice(ln, string.len(needle), string.len(ln)));
        }
        i = i + 1;
    }
    return out;
}

// Live service-discovery reconcile: every `intervalMs`, re-read the endpoints kynatord publishes for `svc`
// and reshape the pool to match (see Pool.setEndpoints). This is what makes "scale a workload up or down
// and traffic follows the live set with zero manual reconfig" true: kynatord rewrites the discovery file
// each reconcile tick, and the data plane picks the change up on its own tick. An empty read (file not yet
// written, or momentarily truncated) is treated as "no change" rather than draining every backend, so a
// transient read never blackholes traffic.
async fn discoveryRefreshLoop(pool: Pool, discoveryFile: string, svc: string, intervalMs: int): int {
    while (true) {
        let _ = await aio.delay(intervalMs);
        let eps = readDiscoveryEndpoints(discoveryFile, svc);
        if (eps.size() == 0) { continue; }
        let changed = pool.setEndpoints(eps);
        if (changed > 0) {
            console.log(`service: discovery reconciled -> ${pool.size()} backend(s) live (${changed} change(s))`);
        }
    }
    return 0;
}

// Serve like serveOnReactor, but also run a live discovery-refresh sibling coroutine so the backend pool
// tracks the control plane's published endpoints as replicas come and go. Used by the `service` binary
// whenever a discoveryFile is configured; the static-backends path stays on serveOnReactor.
pub fn serveOnReactorDiscovery(pool: Pool, port: int, tmo: int,
                               discoveryFile: string, svc: string, refreshMs: int): void {
    let r = poller.Reactor(1024, 16384, 1024);
    poller.setCurrent(r.kq);
    if (pool.hcEnabled) {
        coroStart(healthCheckLoop(pool));
    }
    let iv = if (refreshMs > 0) refreshMs else 1000;
    coroStart(discoveryRefreshLoop(pool, discoveryFile, svc, iv));
    coroStart(proxyAcceptLoop(pool, "", port, tmo));
    console.log(`Kyte reverse proxy listening (single reactor, live discovery every ${iv}ms)`);
    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            kyte_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

struct Handoff {
    pub ctrls: List<int>,
    pub cursor: int,

    init() {
        self.ctrls = List<int>();
        self.cursor = 0;
    }
}

async fn handoffCtrlAcceptLoop(h: Handoff, ulfd: int, kq: int): int {
    while (true) {
        let rs = await eventedio.reactorAccept(ulfd, kq);
        if (rs.isOpen()) {
            h.ctrls.push(rs.fdOf());
            console.log(`proxy: backend app connected (${h.ctrls.size()} live)`);
        }
    }
    return 0;
}

async fn handoffClientAcceptLoop(h: Handoff, port: int, kq: int): int {
    let lfd = sys.socket(sys.AF_INET, sys.SOCK_STREAM, 0);
    let one = bytes.alloc(4);
    bytes.write_i32(one, 0, 1);
    sys.setsockopt(lfd, sys.SOL_SOCKET(), 4, one, 4);
    sys.setReusePort(lfd);
    bytes.free(one);
    let sa = sys.makeSockaddrIn(port, 0);
    if (sys.bind(lfd, sa, 16) != 0) {
        bytes.free(sa);
        console.log("proxy: failed to bind front port (in use?)");
        return -1;
    }
    bytes.free(sa);
    sys.listen(lfd, 512);
    sys.setNonBlocking(lfd);
    while (true) {
        let rs = await eventedio.reactorAccept(lfd, kq);
        if (rs.isOpen()) {
            let cfd = rs.fdOf();
            let n = h.ctrls.size();
            if (n == 0) {
                socket.close(cfd);
            } else {
                let idx = h.cursor % n;
                h.cursor = h.cursor + 1;
                let ctrl = h.ctrls.get(idx) ?? -1;
                let sent = socket.sendFd(ctrl, cfd, "");
                socket.close(cfd);
                if (sent < 0) {
                    socket.close(ctrl);
                    h.ctrls.remove(idx);
                    console.log(`proxy: backend app gone (${h.ctrls.size()} live)`);
                }
            }
        }
    }
    return 0;
}

pub fn serveHandoffOnReactor(port: int, ctrlPath: string, tmo: int): void {
    let r = poller.Reactor(1024, 16384, 1024);
    poller.setCurrent(r.kq);
    let h = Handoff();
    let cp = sys.cstr(ctrlPath);
    sys.unlink(cp);
    bytes.free(cp);
    let u = socket.newUnix();
    let ua = socket.makeSockaddrUn(ctrlPath);
    if (socket.bindSock(u, ua, socket.sockaddrUnLen()) != 0) {
        bytes.free(ua);
        console.log("proxy: handoff AF_UNIX bind failed " + ctrlPath);
        return;
    }
    bytes.free(ua);
    socket.listenSock(u, 128);
    socket.setNonBlock(u);
    coroStart(handoffCtrlAcceptLoop(h, u, r.kq));
    coroStart(handoffClientAcceptLoop(h, port, r.kq));
    console.log("Kyte reverse proxy listening (fd-handoff, single reactor) on " + ctrlPath);
    while (true) {
        let n = r.pollComplete(-1);
        poller.batchBegin();
        let i = 0;
        while (i < n) {
            kyte_reactor_resume(r.completedToken(i));
            i = i + 1;
        }
    }
}

pub async fn serve(pool: Pool, port: int, tmo: int): int {
    return await runProxy(pool, "", port, tmo);
}

pub async fn serveAddr(pool: Pool, host: string, port: int, tmo: int): int {
    return await runProxy(pool, host, port, tmo);
}

pub struct Proxy {
    pub pool: Pool,
    pub port: int,
    pub timeoutMs: int,

    init(pool: Pool, port: int) {
        self.pool = pool;
        self.port = port;
        self.timeoutMs = 15000;
    }

    pub fn setTimeout(self: Proxy, ms: int): void {
        self.timeoutMs = if (ms > 0) ms else 0;
    }

    pub fn run(self: Proxy): void {
        aio.holdReactors();
        let _ = runProxy(self.pool, "", self.port, self.timeoutMs);
    }
}
