// autoscale.ky - PID-controller autoscaling for the I1 reverse proxy.
//
// Two pieces:
//   • PidController - a textbook PID (Kp/Ki/Kd) with anti-windup on the integral term and a clamp on the
//     output. Pure arithmetic over `double`, so it is fully unit-testable (KAT step response).
//   • Autoscaler - a control loop that samples a live load metric off the proxy Pool, runs the PID toward
//     a setpoint, and drives the backend REPLICA COUNT: spawning backend processes via R1 (process.ky)
//     when scaling up and SIGTERM-ing them when scaling down. Managed replicas occupy the first N slots
//     of the pool; a drained slot's `up=0` already excludes it from every LB strategy (see net/proxy).
//
// Standalone driver shape (proxy + autoscaler under one block-drive):
//   aio.holdReactors();
//   let a = autoscale.Autoscaler(pool, "/path/backend", "127.0.0.1", 9101, 1, 8);
//   a.pid.setOutputLimits(1.0, 8.0);
//   let _ = autoscale.runWithProxy(a, 9100, 3000, 500);   // 500ms control interval

import net.proxy;
import net.aio;
import orch.isolation;
import process;
import list;
import math;
import string;

// ---------------------------------------------------------------------------
// PID controller
// ---------------------------------------------------------------------------

pub class PidController {
    pub kp: double,
    pub ki: double,
    pub kd: double,
    pub setpoint: double,
    pub integral: double,      // accumulated error·dt, clamped for anti-windup
    pub prevError: double,
    pub outMin: double,        // output clamp (e.g. [minReplicas, maxReplicas])
    pub outMax: double,
    pub iMin: double,          // anti-windup clamp on the integral term
    pub iMax: double,
    // Direct-acting: error = measured − setpoint (output RISES as the measured load exceeds the setpoint -
    // the correct sign for autoscaling, where more load ⇒ more replicas). Reverse-acting (the textbook
    // default, false) uses error = setpoint − measured.
    pub directActing: bool,
    init(kp: double, ki: double, kd: double, setpoint: double) {
        self.kp = kp;
        self.ki = ki;
        self.kd = kd;
        self.setpoint = setpoint;
        self.integral = 0.0;
        self.prevError = 0.0;
        self.outMin = -1000000.0;
        self.outMax = 1000000.0;
        self.iMin = -1000000.0;
        self.iMax = 1000000.0;
        self.directActing = false;
    }

    pub fn setOutputLimits(self: PidController, lo: double, hi: double): void {
        self.outMin = lo; self.outMax = hi;
    }
    // Anti-windup bounds on the integral accumulator. Keep these near the output range so a long overshoot
    // doesn't wind the integral up past what the clamped output can ever express (the classic windup bug).
    pub fn setIntegralLimits(self: PidController, lo: double, hi: double): void {
        self.iMin = lo; self.iMax = hi;
    }
    pub fn setDirectActing(self: PidController, v: bool): void { self.directActing = v; }
    pub fn reset(self: PidController): void { self.integral = 0.0; self.prevError = 0.0; }

    // One control step: fold in the measured process variable over elapsed `dt` seconds, return the
    // clamped control output. dt<=0 skips the derivative (avoids a divide-by-zero on the first tick).
    pub fn update(self: PidController, measured: double, dt: double): double {
        let error = if (self.directActing) (measured - self.setpoint) else (self.setpoint - measured);
        self.integral = math.fclamp(self.integral + (error * dt), self.iMin, self.iMax);
        let deriv = if (dt > 0.0) ((error - self.prevError) / dt) else 0.0;
        self.prevError = error;
        let out = (self.kp * error) + (self.ki * self.integral) + (self.kd * deriv);
        return math.fclamp(out, self.outMin, self.outMax);
    }
}

// ---------------------------------------------------------------------------
// Autoscaler
// ---------------------------------------------------------------------------

pub struct Autoscaler {
    pub pool: proxy.Pool,
    pub pid: PidController,
    pub cmd: string,               // backend binary to (re)spawn per replica
    pub host: string,              // host the spawned backends listen on (added to the pool)
    pub basePort: int,             // replica slot i listens on basePort + i
    pub minReplicas: int,
    pub maxReplicas: int,
    pub current: int,              // number of replicas currently in rotation (slots 0..current-1)
    pub procs: list.List<process.Process>,  // running replica processes, one per active slot (len == current)
    // Scaled-down processes awaiting a NON-BLOCKING reap. Scale-down sends SIGTERM and parks the Process
    // here instead of blocking the reactor on p.wait(); reapPending() collects them with tryWait (WNOHANG)
    // on later control ticks, so a slow-to-exit backend never stalls reactor 0.
    pub pendingReap: list.List<process.Process>,
    // Per-replica CPU-utilisation control (the k8s-HPA formulation). cpuCgroupPrefix names each replica's
    // cgroup as "<prefix>-<slot>"; the sampler reads that cgroup's cpu.stat usage_usec. The signal driven
    // into the decision is the AVERAGE per-replica utilisation (sum of per-replica core-fractions / replica
    // count), compared to cpuSetpoint which is ALSO per-replica (e.g. 0.7 = 70% of one core each) -- NOT an
    // aggregate sum against an absolute setpoint. cpuPrevUsec holds the previous cumulative usage_usec per
    // slot so each tick can take a delta over the interval. Empty prefix = no cgroups (macOS / unconfigured):
    // the real sampler returns zeros and the CPU path is an inert no-op, exactly like the in-flight default.
    pub cpuCgroupPrefix: string,
    pub cpuSetpoint: double,
    pub cpuPrevUsec: list.List<long>,
    // When false (tests), scaleTo only flips pool slots - it does NOT spawn/kill real processes. Live use
    // leaves it true so the controller actually starts/stops backends.
    pub manageProcesses: bool,
    init(pool: proxy.Pool, cmd: string, host: string, basePort: int, minReplicas: int, maxReplicas: int) {
        self.pool = pool;
        // Sensible autoscaling defaults: gentle proportional gain + integral for a steady base count, no
        // derivative (load samples are noisy). Direct-acting; output clamped to the replica range.
        self.pid = PidController(0.5, 0.1, 0.0, 0.0);
        self.pid.setDirectActing(true);
        self.cmd = cmd;
        self.host = host;
        self.basePort = basePort;
        self.minReplicas = if (minReplicas < 1) 1 else minReplicas;
        self.maxReplicas = if (maxReplicas < self.minReplicas) self.minReplicas else maxReplicas;
        self.current = 0;
        self.procs = list.List<process.Process>();
        self.pendingReap = list.List<process.Process>();
        self.cpuCgroupPrefix = "";
        self.cpuSetpoint = 0.7;                 // default per-replica target: 70% of one core
        self.cpuPrevUsec = list.List<long>();
        self.manageProcesses = true;
        // Pre-register maxReplicas backend slots, all DRAINED (up=0). The LB ring/weight expansion include
        // them but healthyFrom skips any drained slot, so an idle slot is simply invisible until scaled in.
        let i = 0;
        while (i < self.maxReplicas) {
            pool.add(host, basePort + i);
            let b = pool.backends.get(i) ?? proxy.Backend("", 0);
            b.up = 0;
            i = i + 1;
        }
    }

    // Set the load setpoint (target value of the sampled metric) and the PID gains.
    pub fn configure(self: Autoscaler, kp: double, ki: double, kd: double, setpoint: double): void {
        self.pid.kp = kp; self.pid.ki = ki; self.pid.kd = kd; self.pid.setpoint = setpoint;
        self.pid.setOutputLimits(self.minReplicas as double, self.maxReplicas as double);
        self.pid.setIntegralLimits(0.0, self.maxReplicas as double);
    }

    // Bring the running-replica count to `n` (clamped to [min,max]). Scaling UP spawns a backend process
    // (if managed) and un-drains its pool slot; scaling DOWN drains the slot and SIGTERM+reaps the process.
    // Contiguous: slots 0..current-1 are the live replicas, so this only touches the edge slot.
    pub fn scaleTo(self: Autoscaler, n: int): void {
        let target = math.clamp(n, self.minReplicas, self.maxReplicas);
        while (self.current < target) {
            let slot = self.current;
            if (self.manageProcesses) {
                let args = list.List<string>();
                args.push("" + (self.basePort + slot));
                let p = process.Process.spawn(self.cmd, args);
                self.procs.push(p);
            }
            let b = self.pool.backends.get(slot) ?? proxy.Backend("", 0);
            b.up = 1;                          // slot enters LB rotation
            self.current = self.current + 1;
        }
        while (self.current > target) {
            let slot = self.current - 1;
            let b = self.pool.backends.get(slot) ?? proxy.Backend("", 0);
            b.up = 0;                          // slot leaves rotation BEFORE the process dies (no 502s)
            if (self.manageProcesses) {
                let idx = self.procs.size() - 1;
                if (idx >= 0) {
                    let p = self.procs.get(idx) ?? process.Process.spawn("/bin/true", list.List<string>());
                    let _ = p.terminate();     // SIGTERM - graceful
                    // Do NOT p.wait() here: a blocking wait on reactor 0 stalls every other coroutine until
                    // the child exits. Park it for a non-blocking reap (reapPending) on a later tick instead.
                    self.pendingReap.push(p);
                    self.procs.remove(idx);
                }
            }
            self.current = slot;
        }
        self.reapPending();
    }

    // Non-blocking reap of SIGTERM'd, scaled-down processes. tryWait is waitpid(WNOHANG): it returns -2 while
    // the child is still running (left parked for the next call) and the exit status once it has exited (then
    // closed + dropped). This never blocks the reactor -- a child that is slow to drain simply stays parked a
    // few ticks longer. Returns the number still awaiting exit.
    pub fn reapPending(self: Autoscaler): int {
        let i = 0;
        while (i < self.pendingReap.size()) {
            let p = self.pendingReap.get(i) ?? process.Process.spawn("/bin/true", list.List<string>());
            if (p.tryWait() == -2) {
                i = i + 1;                 // still running -- leave parked, check again next tick
            } else {
                p.close();                 // exited -- reaped by tryWait, release the handle
                self.pendingReap.remove(i);
            }
        }
        return self.pendingReap.size();
    }

    // Spawn the minimum replica set. Call once before the control loop starts serving.
    pub fn start(self: Autoscaler): void { self.scaleTo(self.minReplicas); }

    // One control decision: run the PID over the measured metric + elapsed `dt` (seconds) and return the
    // desired replica count (rounded, clamped). Separated from actuation so it is deterministic/testable.
    pub fn decide(self: Autoscaler, measured: double, dt: double): int {
        let out = self.pid.update(measured, dt);
        let r = math.fround(out) as int;
        return math.clamp(r, self.minReplicas, self.maxReplicas);
    }

    // Sample the live metric (total in-flight requests across the pool) and actuate one scaling step.
    pub fn tick(self: Autoscaler, dt: double): void {
        let _ = self.reapPending();        // collect any still-parked scaled-down children (non-blocking)
        let load = self.pool.totalActive() as double;
        self.scaleTo(self.decide(load, dt));
    }

    // ---- per-replica CPU-utilisation control (k8s-HPA style) ----

    // Configure the CPU path: name each replica's cgroup "<prefix>-<slot>" and target `target` core-fraction
    // PER REPLICA (0.7 = 70% of one core each). A non-empty prefix arms the real cgroup sampler.
    pub fn setCpuTarget(self: Autoscaler, prefix: string, target: double): void {
        self.cpuCgroupPrefix = prefix;
        self.cpuSetpoint = target;
    }

    // The cgroup name for replica `slot`.
    pub fn replicaCgroup(self: Autoscaler, slot: int): string {
        return self.cpuCgroupPrefix + "-" + slot;
    }

    // Read the cumulative CPU usage (usage_usec) of EACH live replica's own cgroup - one entry per slot
    // 0..current-1. isolation.cpuUsageUsec returns -1 when unavailable (non-Linux / no cgroup / unconfigured
    // prefix); those become 0 so the signal is a benign no-op rather than noise. This is the per-replica
    // measurement the criterion asks for: one sample per replica, never a single aggregate figure.
    pub fn readPerReplicaUsec(self: Autoscaler): list.List<long> {
        let out = list.List<long>();
        if (string.eql(self.cpuCgroupPrefix, "")) { return out; }   // unarmed → empty (no per-replica samples)
        let i = 0;
        while (i < self.current) {
            let u = isolation.cpuUsageUsec(self.replicaCgroup(i));
            out.push(if (u < 0) (0 as long) else u);
            i = i + 1;
        }
        return out;
    }

    // Average per-replica CPU utilisation over the interval `dt` (seconds): for each live replica, the delta
    // of its cumulative usage_usec since the previous sample divided by the wall interval gives its core
    // fraction; the returned signal is the MEAN across replicas (aggregate / count), which is what a
    // per-replica setpoint is compared against. A slot with no previous sample (freshly scaled up) or a reset
    // counter contributes 0 for this interval (warm-up). Records `nowUsec` as the new baseline. dt<=0 or no
    // replicas → 0. This is a PURE function of its inputs + cpuPrevUsec, so it is directly unit-testable with
    // injected cumulative-usec vectors (no live cgroup needed).
    pub fn avgCpuUtil(self: Autoscaler, nowUsec: list.List<long>, dt: double): double {
        let n = nowUsec.size();
        if (dt <= 0.0 || n <= 0) { self.recordUsec(nowUsec); return 0.0; }
        let usecPerSec = dt * 1000000.0;
        let sum = 0.0;
        let i = 0;
        while (i < n) {
            let now = nowUsec.get(i) ?? (0 as long);
            let prev = if (i < self.cpuPrevUsec.size()) (self.cpuPrevUsec.get(i) ?? (-1 as long)) else (-1 as long);
            if (prev >= (0 as long) && now >= prev) {
                let delta = (now - prev) as double;
                sum = sum + (delta / usecPerSec);
            }
            i = i + 1;
        }
        self.recordUsec(nowUsec);
        return sum / (n as double);
    }

    // Replace the per-slot cumulative-usec baseline with `nowUsec`.
    fn recordUsec(self: Autoscaler, nowUsec: list.List<long>): void {
        self.cpuPrevUsec.clear();
        let i = 0;
        while (i < nowUsec.size()) {
            self.cpuPrevUsec.push(nowUsec.get(i) ?? (0 as long));
            i = i + 1;
        }
    }

    // The per-replica scaling decision: desiredReplicas = ceil(current · avgUtil / cpuSetpoint), clamped to
    // [min,max] - the canonical HPA ratio. Because both the numerator signal (avgUtil) and the denominator
    // (cpuSetpoint) are PER REPLICA, doubling the replica count at a fixed per-replica load leaves the
    // decision stable (unlike an aggregate-sum signal, which would keep chasing its own tail). A non-positive
    // setpoint or zero current is treated as "hold".
    pub fn decideCpu(self: Autoscaler, avgUtil: double): int {
        if (self.cpuSetpoint <= 0.0) { return math.clamp(self.current, self.minReplicas, self.maxReplicas); }
        let base = if (self.current < 1) 1 else self.current;
        let desired = math.fceil((base as double) * avgUtil / self.cpuSetpoint) as int;
        return math.clamp(desired, self.minReplicas, self.maxReplicas);
    }

    // One CPU-driven control step: sample every replica's own cgroup, average the per-replica utilisation over
    // `dt`, and actuate. Reaps parked children first (non-blocking). On a host without cgroups this is inert
    // (empty samples → avgUtil 0 → holds at the current count).
    pub fn tickCpu(self: Autoscaler, dt: double): void {
        let _ = self.reapPending();
        let now = self.readPerReplicaUsec();
        if (now.size() == 0) { return; }   // metrics unavailable (unarmed / non-Linux) → HOLD, never thrash
        let avg = self.avgCpuUtil(now, dt);
        self.scaleTo(self.decideCpu(avg));
    }
}

// The autoscaler's background control loop: every `intervalMs` sample the metric and rescale. Runs as one
// coroutine (spawn it on reactor 0). Never returns.
pub async fn autoscaleLoop(a: Autoscaler, intervalMs: int): int {
    let dt = (intervalMs as double) / 1000.0;
    while (true) {
        let _ = await aio.sleep(intervalMs);
        a.tick(dt);
    }
    return 0;
}

// Run the proxy and the autoscaler together under a single block-drive: spawn the control loop on reactor
// 0, then serve the front port with the share-nothing accept fan-out. Caller must have called
// aio.holdReactors() first (so the fan-out lands on live reactors), exactly like Proxy.run.
pub async fn runWithProxy(a: Autoscaler, port: int, tmo: int, intervalMs: int): int {
    a.start();                                 // spawn the minimum replicas
    aio.pinNextCoro(0);
    spawn autoscaleLoop(a, intervalMs);
    return await proxy.serve(a.pool, port, tmo);
}
