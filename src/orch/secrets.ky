// orch/secrets.ky -- file-mounted secret delivery for supervised workloads (ROADMAP-1.0 Tier 2).
//
// A workload references a secret by HANDLE, never by value: `workload.secrets` is an array of
// "ENVVAR=/abs/path" entries. The manifest and the config store hold only the PATH; the secret VALUE lives
// in a file on the node, provisioned out-of-band (a mounted tmpfs, a systemd credential, an operator drop).
// At spawn, kynatord reads each file and delivers its content as ENVVAR to the child (appended to the same
// env list as `env`, so it flows through spawnEx race-free). The value therefore never appears in the
// manifest, the store, `/metrics`, or the process table's argv -- only in the child's environment.
import string;
import list;
import io.file;

// "ENVVAR=/abs/path" for each ref -> "ENVVAR=<file content>" (trailing newline trimmed, as secret files
// conventionally end in one). A ref with an empty key/path, or a missing/unreadable file, yields NO entry:
// the variable is left UNSET rather than delivered empty or partially, so a mis-provisioned secret fails
// loud in the app (missing var) instead of silently becoming "". Reads happen per spawn, so rotating the
// file and restarting the replica picks up the new value with no manifest change.
pub fn resolveSecretEnv(refs: list.List<string>): list.List<string> {
    let out = list.List<string>();
    let i = 0;
    while (i < refs.size()) {
        let ref = refs.get(i) ?? "";
        i = i + 1;
        let eq = string.indexOf(ref, "=");
        if (eq < 1) { continue; }
        let key = string.slice(ref, 0, eq);
        let path = string.slice(ref, eq + 1, string.len(ref));
        if (string.eql(path, "") || !file.File.exists(path)) { continue; }
        let val = string.trimEnd(file.File.readText(path));
        out.push(key + "=" + val);
    }
    return out;
}

// Validate one secret ref: "ENVVAR=/path" with a non-empty key and a non-empty, ABSOLUTE path (a relative
// path is rejected because the child's cwd is not the operator's). Returns "" when valid, else the problem.
pub fn secretRefError(ref: string): string {
    let eq = string.indexOf(ref, "=");
    if (eq < 1) { return "secret must be \"ENVVAR=/abs/path\" with a non-empty env-var name (got \"" + ref + "\")"; }
    let path = string.slice(ref, eq + 1, string.len(ref));
    if (string.eql(path, "")) { return "secret \"" + ref + "\" has an empty path"; }
    if (!string.startsWith(path, "/")) { return "secret path must be absolute (got \"" + path + "\")"; }
    return "";
}
