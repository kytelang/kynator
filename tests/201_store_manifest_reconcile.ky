// 201 -- the store reconcile path is manifest-aware. reconcileFromEntries now sniffs each store value:
// a declarative YAML Manifest (what the web control plane and kynatorctl write) is parsed + validated +
// lowered to a Spec exactly like a *.yaml on disk, while a raw JSON Spec ('{'...) still parses as the
// legacy form. This closes the loop: a manifest a UI writes into the config store under workloads/<name>
// is understood by the same reconcile machinery that drives the fleet. Complements 191 (JSON rollout
// safety) and 200 (the file-scan YAML cutover). Exercised in memory with manageProcesses=false.
import assert;
import string;
import store.config;
import orch.nativelet;
import orch.spec;

// A declarative YAML manifest string (the canonical form the control plane stores).
fn manifestYaml(name: string, min: int, max: int): string {
    return `metadata:\n  name: ${name}\n` +
           `workload:\n  binary: /bin/${name}\n  restartPolicy: always\n` +
           `replicas:\n  min: ${min}\n  max: ${max}\n` +
           "lb:\n  strategy: roundrobin\n  handoff: true\n" +
           "network:\n  expose: gateway-only\n  servicePort: 8140\n";
}
// A JSON Spec (the legacy store form) -- must still parse on the same path.
fn specJson(name: string, reps: int): string {
    return "{\"name\":\"" + name + "\",\"binaryPath\":\"/bin/" + name + "\",\"replicas\":" + reps + "}";
}

// A YAML manifest in the store reconciles like a manifest on disk: replicas.min is the desired count and
// lb.handoff lowers to the handoff data path.
@test
fn test_store_yaml_manifest_applies(): void {
    let store = config.ConfigStore();
    let n = nativelet.Nativelet("unused-dir");
    n.manageProcesses = false;

    let _1 = store.put("workloads/shop", manifestYaml("shop", 3, 6));
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.jobs.size(), 1);
    assert.isTrue(n.findJobIdx("shop") >= 0);
    assert.equalInt(n.desiredReplicas("shop"), 3);       // replicas.min is the initial desired count
}

// The two store forms coexist: a JSON Spec and a YAML Manifest under the same prefix both reconcile.
@test
fn test_store_mixed_json_and_yaml(): void {
    let store = config.ConfigStore();
    let n = nativelet.Nativelet("unused-dir");
    n.manageProcesses = false;

    let _1 = store.put("workloads/legacy", specJson("legacy", 2));   // legacy JSON spec
    let _2 = store.put("workloads/shop", manifestYaml("shop", 4, 8)); // YAML manifest
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.jobs.size(), 2);
    assert.equalInt(n.desiredReplicas("legacy"), 2);
    assert.equalInt(n.desiredReplicas("shop"), 4);
}

// Rollout safety on the manifest path: a bad manifest UPDATE (missing workload.binary) is treated like an
// unreadable manifest -- the last-good workload keeps running at its previous replica count.
@test
fn test_store_bad_manifest_keeps_last_good(): void {
    let store = config.ConfigStore();
    let n = nativelet.Nativelet("unused-dir");
    n.manageProcesses = false;

    let _1 = store.put("workloads/shop", manifestYaml("shop", 2, 6));
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.desiredReplicas("shop"), 2);

    // A manifest missing workload.binary -> validateManifest fails -> not applied; shop stays at 2.
    let _2 = store.put("workloads/shop", "metadata:\n  name: shop\nreplicas:\n  min: 5\n  max: 9\n");
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.desiredReplicas("shop"), 2);       // unchanged: the broken manifest was NOT applied

    // A good manifest update after the bad one still applies.
    let _3 = store.put("workloads/shop", manifestYaml("shop", 7, 9));
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.desiredReplicas("shop"), 7);
}

// A brand-new workload whose FIRST stored manifest is invalid is never started.
@test
fn test_store_bad_new_manifest_not_started(): void {
    let store = config.ConfigStore();
    let n = nativelet.Nativelet("unused-dir");
    n.manageProcesses = false;

    let _1 = store.put("workloads/shop", manifestYaml("shop", 1, 3));   // one good workload
    let _2 = store.put("workloads/broken", "metadata:\n  name: broken\n");   // no workload.binary
    n.reconcileFromEntries(store.list("workloads/"), "workloads/");
    assert.equalInt(n.jobs.size(), 1);
    assert.isTrue(n.findJobIdx("shop") >= 0);
    assert.isTrue(n.findJobIdx("broken") < 0);
}
