// 211 -- file-mounted secret delivery (ROADMAP-1.0 Tier 2). A workload references a secret by HANDLE
// ("ENVVAR=/abs/path"); the manifest and the re-emitted manifest carry only the PATH, never the value; the
// resolver reads the file at spawn and yields "ENVVAR=<value>" for the child. The secret VALUE must be
// absent from every persisted/observable surface (manifest text, spec's secretRefs) and present only in
// the resolved spawn env.
import assert;
import orch.manifest;
import orch.secrets;
import orch.spec;
import io.file;
import io.dir;
import string;
import list;

const DIR: string = "/tmp/kyn211";
const SECRET_VALUE: string = "s3cr3t-P@ssw0rd-DO-NOT-LEAK";

fn seedSecretFile(): string {
    let _ = dir.Dir.create(DIR, 493);
    let path = DIR + "/db_password";
    file.File.writeText(path, SECRET_VALUE + "\n");   // trailing newline, as secret files conventionally have
    return path;
}

fn maniText(path: string): string {
    return "apiVersion: kyte/v1\nkind: App\nmetadata: { name: sec }\n" +
           "workload:\n  binary: /bin/x\n  secrets: [ \"DB_PASSWORD=" + path + "\" ]\n" +
           "replicas: { min: 1, max: 1 }\nnetwork: { expose: gateway-only }\n";
}

@test
fn manifest_holds_only_the_handle_not_the_value(): void {
    let path = seedSecretFile();
    let text = maniText(path);
    // the operator's manifest references the path; the value is nowhere in it.
    assert.isTrue(string.contains(text, path));
    assert.isTrue(!string.contains(text, SECRET_VALUE));
    let m = manifest.parseManifest(text);
    assert.equalStr(manifest.validateManifest(m), "");
    // re-emitting the manifest (what the control plane stores) still carries only the handle.
    let round = manifest.toYaml(m);
    assert.isTrue(string.contains(round, path));
    assert.isTrue(!string.contains(round, SECRET_VALUE));
}

@test
fn spec_carries_the_handle_not_the_value(): void {
    let path = seedSecretFile();
    let m = manifest.parseManifest(maniText(path));
    let s = manifest.toSpec(m);
    assert.equalInt(s.secretRefs.size(), 1);
    assert.isTrue(string.contains(s.secretRefs.get(0) ?? "", path));       // path
    assert.isTrue(!string.contains(s.secretRefs.get(0) ?? "", SECRET_VALUE)); // never the value
    // spec.env (the plaintext env surface) is empty -- the secret is NOT a plaintext env entry.
    assert.equalInt(s.env.size(), 0);
}

@test
fn resolver_reads_the_value_only_at_spawn(): void {
    let path = seedSecretFile();
    let refs = list.List<string>();
    refs.push("DB_PASSWORD=" + path);
    let env = secrets.resolveSecretEnv(refs);
    assert.equalInt(env.size(), 1);
    // the resolved spawn env carries KEY=<value>, trailing newline trimmed.
    assert.isTrue(string.eql(env.get(0) ?? "", "DB_PASSWORD=" + SECRET_VALUE));
}

@test
fn missing_secret_file_yields_no_entry(): void {
    let refs = list.List<string>();
    refs.push("DB_PASSWORD=/tmp/kyn211/does-not-exist");
    assert.equalInt(secrets.resolveSecretEnv(refs).size(), 0);   // unset, never empty/garbage
}

@test
fn bad_secret_refs_are_rejected(): void {
    assert.isTrue(!string.eql(secrets.secretRefError("NOEQUALS"), ""));          // no "="
    assert.isTrue(!string.eql(secrets.secretRefError("K="), ""));                // empty path
    assert.isTrue(!string.eql(secrets.secretRefError("K=relative/path"), ""));   // not absolute
    assert.equalStr(secrets.secretRefError("K=/abs/ok"), "");                    // valid
}
